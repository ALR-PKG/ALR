# alr-test-setup — подготовка e2e-окружения внутри тестового контейнера.
# Выполняется от пользователя alr (USER в образе), sudo уже passwordless.
set -e

case "$1" in
alr-install)
	# /tmp/alr-bin — свежесобранный бинарник, смонтированный из e2e-tests/alr
	# (нельзя монтировать в /tmp/alr — это рабочая директория сборок ALR)
	sudo install -m 0755 /tmp/alr-bin /usr/local/bin/alr
	;;
passwordless-sudo-setup)
	# sudoers настраивается при сборке образа, здесь только проверка
	if ! sudo -n true 2>/dev/null; then
		echo "alr-test-setup: passwordless sudo не настроен" >&2
		exit 1
	fi
	;;
*)
	echo "usage: alr-test-setup {alr-install|passwordless-sudo-setup}" >&2
	exit 1
	;;
esac
